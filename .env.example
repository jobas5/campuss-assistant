# Copy this file to .env and fill in your own values. Never commit .env.

# Text LLM — any OpenAI-compatible endpoint (CommandCode / DeepSeek / ...)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-key-here
LLM_MODEL=deepseek-chat

# Vision LLM for Module 12 (must accept images). Leave empty to reuse the LLM_* values.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Local models (downloaded from Hugging Face on first run)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL=BAAI/bge-reranker-v2-m3
